# ResumeIQ Environment Variables Example
# Copy this file to .env and fill in the values if you add these features later.

# The domain where your app is hosted (e.g., https://resume-iq.vercel.app)
VITE_BASE_URL=https://your-domain.com

# --- FUTURE ADDITIONS (Optional) ---
# If you eventually move away from Puter AI to direct OpenAI calls:
# VITE_OPENAI_API_KEY=your_secret_key_here

# For professional analytics (e.g., Google Analytics):
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
